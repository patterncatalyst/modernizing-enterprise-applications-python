            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [ { \"sku\": \"SKU-WIDGET-001\", \"quantity\": 1 } ],\n  \"paymentMethod\": \"CARD-VISA\",\n  \"shippingAddress\": \"1 Equivalence Suite Way, Testville\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Location header present and references the created order', function () {",
                  "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "    var json = pm.response.json();",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/api/orders/' + json.id);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('happyPathOrderId', json.id);",
                  "pm.test('Order status is CONFIRMED (synchronous checkout -- no PENDING to observe at r01)', function () {",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "});",
                  "pm.test('Order total matches one widget unit price (1999 cents)', function () {",
                  "    pm.expect(json.totalCents).to.eql(1999);",
                  "});",
                  "pm.test('Order items echo the checkout line', function () {",
                  "    pm.expect(json.items).to.have.lengthOf(1);",
                  "    pm.expect(json.items[0].sku).to.eql('SKU-WIDGET-001');",
                  "    pm.expect(json.items[0].quantity).to.eql(1);",
                  "    pm.expect(json.items[0].unitPriceCents).to.eql(1999);",
                  "});",
                  "pm.test('Order id is a number', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "});"
                ]
              }
