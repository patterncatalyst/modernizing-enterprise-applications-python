{
  "info": {
    "name": "Modernizing Enterprise Applications (Python) — Behavior-Equivalence Suite",
    "_postman_id": "mea-python-equivalence-suite",
    "description": "r01 golden baseline (walking skeleton). Captured against the running Django monolith (examples/00-monolith) — the ONLY backend that exists at r01, so {{baseUrl}} points straight at it (http://localhost:8000). This is the Python sibling of ~/Dev/modernizing-enterprise-applications/tooling/newman/mea.postman_collection.json, scoped down to that project's r02 synchronous-monolith baseline: Smoke + four checkout scenarios, no bounded-wait polling of any kind, because r01 has no extracted services and no asynchrony to wait on yet. Every request is parameterized by {{baseUrl}} on purpose — this exact, unedited collection is meant to be re-pointed at each later iteration's extracted service/proxy as it lands, the same load-bearing contract the Java project's suite plays. See GOLDEN-BASELINE.md for the full run record and the four smell-cross-reference failure paths this exercises (common/exceptions.py's ApiError subclasses, order/services.py's single transaction.atomic()).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "Service is reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inventory list returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('Seed inventory includes all three seeded SKUs', function () {",
                  "    var skus = pm.response.json().map(function (i) { return i.sku; });",
                  "    pm.expect(skus).to.include('SKU-WIDGET-001');",
                  "    pm.expect(skus).to.include('SKU-GADGET-002');",
                  "    pm.expect(skus).to.include('SKU-GIZMO-003');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenario 1 — Happy-Path Checkout",
      "item": [
        {
          "name": "1a. Capture stock before checkout",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/SKU-WIDGET-001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "SKU-WIDGET-001"]
