                  "});",
                  "pm.test('camelCase echo matches the submitted review', function () {",
                  "    pm.expect(json).to.have.all.keys('id', 'customerId', 'sku', 'rating', 'comment', 'createdAt');",
                  "    pm.expect(json.customerId).to.eql(1);",
                  "    pm.expect(json.sku).to.eql('SKU-WIDGET-001');",
                  "    pm.expect(json.rating).to.eql(5);",
                  "    pm.expect(json.comment).to.eql('Newman cutover-suite review -- authenticated write.');",
                  "});",
                  "pm.collectionVariables.set('newReviewId', json.id);"
                ]
              }
            }
          ]
        },
