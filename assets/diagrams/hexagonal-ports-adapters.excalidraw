   "versionNonce": 336170245,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "driving adapters translate a protocol into an inbound-port call; driven adapters implement the outbound port the core declared",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "driving adapters translate a protocol into an inbound-port call; driven adapters implement the outbound port the core declared",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t546531005",
