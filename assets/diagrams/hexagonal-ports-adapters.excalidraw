   "versionNonce": 1299187417,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the core never imports a protocol -- a protocol can be swapped without the core noticing",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the core never imports a protocol -- a protocol can be swapped without the core noticing",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
