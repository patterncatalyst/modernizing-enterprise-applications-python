   "link": null,
   "locked": false,
   "text": "The reference monolith (before): six bounded contexts, one deployable, one shared schema",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The reference monolith (before): six bounded contexts, one deployable, one shared schema",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t1157836048",
