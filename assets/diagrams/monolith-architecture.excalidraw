   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1185222540",
   "type": "text",
   "x": 1420,
   "y": 410,
   "width": 883.575,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 91050229,
   "versionNonce": 1072450516,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #2: place_order() wraps inventory + order + payment + shipment + the outbox write in ONE transaction.atomic() spanning five contexts (ACID -> ACD).",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #2: place_order() wraps inventory + order + payment + shipment + the outbox write in ONE transaction.atomic() spanning five contexts (ACID -> ACD).",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t779019500",
   "type": "text",
   "x": 40,
   "y": 588,
   "width": 1079.9250000000002,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 882289096,
   "versionNonce": 68554651,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #4: FK joins cross bounded-context boundaries freely inside the one shared schema -- orders->customers, payments/shipments/notifications->orders, reviews->customers+inventory_items.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #4: FK joins cross bounded-context boundaries freely inside the one shared schema -- orders->customers, payments/shipments/notifications->orders, reviews->customers+inventory_items.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1857546768",
   "type": "text",
   "x": 40,
   "y": 604,
   "width": 710.325,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1658676516,
   "versionNonce": 133298729,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "common.Customer is a shared-kernel entity (not its own bounded context) FK'd directly from order, notification, and review.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "common.Customer is a shared-kernel entity (not its own bounded context) FK'd directly from order, notification, and review.",
