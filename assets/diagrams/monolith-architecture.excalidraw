  },
  {
   "id": "t553684294",
   "type": "text",
   "x": 1420,
   "y": 410,
   "width": 883.575,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 982793864,
   "versionNonce": 1100346370,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #2: place_order() wraps inventory + order + payment + shipment + the outbox write in ONE transaction.atomic() spanning five contexts (ACID -> ACD).",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #2: place_order() wraps inventory + order + payment + shipment + the outbox write in ONE transaction.atomic() spanning five contexts (ACID -> ACD).",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t1102626283",
   "type": "text",
   "x": 40,
   "y": 588,
   "width": 1079.9250000000002,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 827619830,
   "versionNonce": 839067518,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #4: FK joins cross bounded-context boundaries freely inside the one shared schema -- orders->customers, payments/shipments/notifications->orders, reviews->customers+inventory_items.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #4: FK joins cross bounded-context boundaries freely inside the one shared schema -- orders->customers, payments/shipments/notifications->orders, reviews->customers+inventory_items.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t94519424",
   "type": "text",
   "x": 40,
   "y": 604,
   "width": 710.325,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 387188305,
   "versionNonce": 564075597,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "common.Customer is a shared-kernel entity (not its own bounded context) FK'd directly from order, notification, and review.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "common.Customer is a shared-kernel entity (not its own bounded context) FK'd directly from order, notification, and review.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
