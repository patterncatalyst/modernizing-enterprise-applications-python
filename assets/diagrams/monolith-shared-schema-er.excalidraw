   "versionNonce": 1659217165,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #3/#4: every amber FK below crosses a bounded-context ownership boundary, enforced only because everything shares one database",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #3/#4: every amber FK below crosses a bounded-context ownership boundary, enforced only because everything shares one database",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
