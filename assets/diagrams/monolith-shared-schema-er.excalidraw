   "versionNonce": 742431004,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "order_items -> inventory_items is not one of these FKs: sku/item_name/unit_price_cents are captured as a snapshot at checkout time instead.",
   "fontSize": 10,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "order_items -> inventory_items is not one of these FKs: sku/item_name/unit_price_cents are captured as a snapshot at checkout time instead.",
