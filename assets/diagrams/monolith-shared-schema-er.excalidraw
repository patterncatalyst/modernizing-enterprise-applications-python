   "roundness": null,
   "seed": 1622419124,
   "versionNonce": 849176372,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SMELL #3/#4: every amber FK below crosses a bounded-context ownership boundary, enforced only because everything shares one database",
   "fontSize": 11.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SMELL #3/#4: every amber FK below crosses a bounded-context ownership boundary, enforced only because everything shares one database",
   "lineHeight": 1.25,
   "baseline": 11.5
  },
  {
   "id": "t1046892188",
   "type": "text",
   "x": 40,
   "y": 536,
   "width": 836.0000000000001,
   "height": 12.5,
   "angle": 0,
   "strokeColor": "#777777",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1422213448,
   "versionNonce": 168513917,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "order_items -> inventory_items is not one of these FKs: sku/item_name/unit_price_cents are captured as a snapshot at checkout time instead.",
   "fontSize": 10,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "order_items -> inventory_items is not one of these FKs: sku/item_name/unit_price_cents are captured as a snapshot at checkout time instead.",
