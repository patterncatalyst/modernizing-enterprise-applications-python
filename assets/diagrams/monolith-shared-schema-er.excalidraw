   "baseline": 17
  },
  {
   "id": "t891477421",
   "type": "text",
   "x": 750.0,
   "y": 46,
   "width": 834.9000000000001,
   "height": 14.375,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
