  {
   "id": "t1692205822",
   "type": "text",
   "x": 40,
   "y": 704,
   "width": 671.5500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348421187,
   "versionNonce": 1481627233,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At-least-once is a promise about the PIPE, not the effect -- the relay can republish, the broker can redeliver.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At-least-once is a promise about the PIPE, not the effect -- the relay can republish, the broker can redeliver.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1121152979",
   "type": "text",
   "x": 40,
   "y": 722,
   "width": 677.6,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
