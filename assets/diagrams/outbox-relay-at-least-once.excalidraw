   "seed": 471148490,
   "versionNonce": 1377232895,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At-least-once is a promise about the PIPE, not the effect -- the relay can republish, the broker can redeliver.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At-least-once is a promise about the PIPE, not the effect -- the relay can republish, the broker can redeliver.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t423582275",
   "type": "text",
   "x": 40,
   "y": 722,
   "width": 677.6,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
