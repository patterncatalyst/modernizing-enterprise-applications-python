   "roundness": null,
   "seed": 1268244605,
   "versionNonce": 523982614,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Idempotency at the consumer is what makes redelivery safe; which idiom fits depends on what kind of write it is.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Idempotency at the consumer is what makes redelivery safe; which idiom fits depends on what kind of write it is.",
