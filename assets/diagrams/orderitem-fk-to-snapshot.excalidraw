   "link": null,
   "locked": false,
   "text": "A later price change in inventory never retroactively rewrites a historical order line -- correct read-model semantics either way checkout runs.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A later price change in inventory never retroactively rewrites a historical order line -- correct read-model semantics either way checkout runs.",
   "lineHeight": 1.25,
   "baseline": 11
  },
