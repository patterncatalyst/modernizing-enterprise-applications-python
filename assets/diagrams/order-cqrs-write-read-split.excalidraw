   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CQRS, concretely: one write aggregate, one projection, upserted in the same transaction as every mutation",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CQRS, concretely: one write aggregate, one projection, upserted in the same transaction as every mutation",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t259576625",
   "type": "text",
   "x": 40,
   "y": 570,
   "width": 726.0000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1316589594,
   "versionNonce": 1243065202,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "This buys read-after-write consistency WITHIN this service: a GET issued right after a 202 sees the new PENDING row with",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This buys read-after-write consistency WITHIN this service: a GET issued right after a 202 sees the new PENDING row with",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1948708073",
   "type": "text",
   "x": 40,
   "y": 588,
   "width": 719.95,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 181233110,
   "versionNonce": 58151204,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "no delay. It does not buy cross-service consistency, CONFIRMED is only as fresh as the saga event that drives it there.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "no delay. It does not buy cross-service consistency, CONFIRMED is only as fresh as the saga event that drives it there.",
   "lineHeight": 1.25,
   "baseline": 11
  }
