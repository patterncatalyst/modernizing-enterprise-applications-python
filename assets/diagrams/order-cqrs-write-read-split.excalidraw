   "type": "text",
   "x": 680.0,
   "y": 20,
   "width": 924.0000000000001,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
