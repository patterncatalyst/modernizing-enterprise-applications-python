   "link": null,
   "locked": false,
   "text": "ch.21 -- CQRS, concretely: one write aggregate, one projection, upserted in the SAME transaction as every mutation",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.21 -- CQRS, concretely: one write aggregate, one projection, upserted in the SAME transaction as every mutation",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t1994140949",
   "type": "text",
   "x": 40,
   "y": 570,
   "width": 726.0000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 853943696,
   "versionNonce": 306547640,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "This buys read-after-write consistency WITHIN this service: a GET issued right after a 202 sees the new PENDING row with",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This buys read-after-write consistency WITHIN this service: a GET issued right after a 202 sees the new PENDING row with",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t171058914",
   "type": "text",
   "x": 40,
   "y": 588,
   "width": 732.0500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 80627143,
   "versionNonce": 687268321,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "no delay. It does not buy cross-service consistency -- CONFIRMED is only as fresh as the saga event that drives it there.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "no delay. It does not buy cross-service consistency -- CONFIRMED is only as fresh as the saga event that drives it there.",
   "lineHeight": 1.25,
   "baseline": 11
  }
