   "lineHeight": 1.25,
   "baseline": 15
  },
  {
   "id": "t585781318",
   "type": "text",
   "x": 240,
   "y": 754,
   "width": 925.6500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 546513508,
   "versionNonce": 586096089,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Injection is by the istio.io/rev: default pod-template LABEL (app-deployment.yaml) -- Sail's revisioned webhook ignores sidecar.istio.io/inject entirely.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Injection is by the istio.io/rev: default pod-template LABEL (app-deployment.yaml) -- Sail's revisioned webhook ignores sidecar.istio.io/inject entirely.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t136751103",
   "type": "text",
   "x": 240,
   "y": 772,
   "width": 816.7500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 215848956,
   "versionNonce": 1843222361,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Without the per-Route PERMISSIVE PeerAuthentication, the STRICT default would 502 every Route request: the router is not a mesh member.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Without the per-Route PERMISSIVE PeerAuthentication, the STRICT default would 502 every Route request: the router is not a mesh member.",
   "lineHeight": 1.25,
   "baseline": 11
  },
