   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The async Kafka saga hops (order.placed -> payment -> shipping) are deliberately out of this trace: mesh-visible in Kiali, app-level-deferred (same posture as the Java sibling).",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The async Kafka saga hops (order.placed -> payment -> shipping) are deliberately out of this trace: mesh-visible in Kiali, app-level-deferred (same posture as the Java sibling).",
   "lineHeight": 1.25,
   "baseline": 11
  },
