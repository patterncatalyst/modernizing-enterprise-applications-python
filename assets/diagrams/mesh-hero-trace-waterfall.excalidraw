   "link": null,
   "locked": false,
   "text": "The async Kafka saga hops (order.placed -> payment -> shipping) are out of this trace: mesh-visible in Kiali, app-level-deferred (same posture as the Java sibling).",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
