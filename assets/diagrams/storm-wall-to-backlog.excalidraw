   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The anti-corruption layer is the precondition at every row above: an event can't carry contract-shaped data until the ACL exists at that seam.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The anti-corruption layer is the precondition at every row above: an event can't carry contract-shaped data until the ACL exists at that seam.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
