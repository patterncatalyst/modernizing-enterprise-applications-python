   "locked": false,
   "text": "ch.17 -- one outbox row, two independent consumer groups, one flag choosing who answers the read",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.17 -- one outbox row, two independent consumer groups, one flag choosing who answers the read",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t1140699984",
   "type": "text",
   "x": 30,
   "y": 240,
   "width": 706.2,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
