   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "one outbox row, two independent consumer groups, one flag choosing who answers the read",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
   "id": "t1839422490",
   "type": "text",
   "x": 30,
   "y": 240,
   "width": 693.0,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1500043370,
   "versionNonce": 919351918,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both consumer groups run for the ENTIRE strangle window, the monolith becomes a consumer of its own event",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both consumer groups run for the ENTIRE strangle window, the monolith becomes a consumer of its own event",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1514506989",
