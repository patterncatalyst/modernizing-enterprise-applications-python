   "versionNonce": 810819991,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka delivery is AT-LEAST-ONCE end to end: the relay can republish, and each consumer can redeliver on its own restart.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka delivery is AT-LEAST-ONCE end to end: the relay can republish, and each consumer can redeliver on its own restart.",
   "lineHeight": 1.25,
   "baseline": 11
  }
