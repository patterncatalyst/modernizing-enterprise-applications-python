   "seed": 1311156608,
   "versionNonce": 1887393865,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both consumer groups run for the ENTIRE strangle window -- the monolith becomes a consumer of its own event",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both consumer groups run for the ENTIRE strangle window -- the monolith becomes a consumer of its own event",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
