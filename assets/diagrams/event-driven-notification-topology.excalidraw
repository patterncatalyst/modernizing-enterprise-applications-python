   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "(the decorating-collaborator pattern), not a placeholder removed once notification-service ships.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
