   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two layers, not one: the application-level check (get_by_order_id) is the common case; the partial unique index",
   "lineHeight": 1.25,
   "baseline": 11
  },
