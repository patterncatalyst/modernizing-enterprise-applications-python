   "versionNonce": 601557071,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order's own extraction can't complete until each of the other five has removed one of its three outbound edges -- which is why order goes last, not first.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Order's own extraction can't complete until each of the other five has removed one of its three outbound edges -- which is why order goes last, not first.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
