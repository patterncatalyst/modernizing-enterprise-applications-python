   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "let alone its database rows: it proves the implementation, not the behavior, is correct.",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "let alone its database rows: it proves the implementation, not the behavior, is correct.",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
