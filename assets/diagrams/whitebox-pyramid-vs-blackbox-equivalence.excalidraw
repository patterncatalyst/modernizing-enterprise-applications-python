   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ch.10: same system, two kinds of test: white-box pytest pyramid vs. black-box equivalence suite",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ch.10: same system, two kinds of test: white-box pytest pyramid vs. black-box equivalence suite",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t208920901",
   "type": "text",
   "x": 780.0,
   "y": 46,
   "width": 600.6,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 917330988,
   "versionNonce": 1290203454,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the pyramid imports Python package names; the equivalence suite only knows baseUrl and HTTP",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the pyramid imports Python package names; the equivalence suite only knows baseUrl and HTTP",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t426702017",
   "type": "text",
   "x": 110,
   "y": 565,
   "width": 502.42500000000007,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1052049052,
   "versionNonce": 505231352,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A white-box test can't import a module that doesn't share the monolith's package names,",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A white-box test can't import a module that doesn't share the monolith's package names,",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t207995194",
   "type": "text",
   "x": 110,
   "y": 581,
   "width": 513.975,
   "height": 13.125,
