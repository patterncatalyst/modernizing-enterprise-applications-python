   "roundness": null,
   "seed": 1244061249,
   "versionNonce": 687125739,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A white-box test can't import a module that doesn't share the monolith's package names,",
   "fontSize": 10.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A white-box test can't import a module that doesn't share the monolith's package names,",
   "lineHeight": 1.25,
   "baseline": 10.5
  },
  {
   "id": "t91259115",
