   "versionNonce": 1193530500,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the pyramid imports Python package names; the equivalence suite only knows baseUrl and HTTP",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the pyramid imports Python package names; the equivalence suite only knows baseUrl and HTTP",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t619504530",
   "type": "text",
   "x": 110,
   "y": 565,
   "width": 502.42500000000007,
   "height": 13.125,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
