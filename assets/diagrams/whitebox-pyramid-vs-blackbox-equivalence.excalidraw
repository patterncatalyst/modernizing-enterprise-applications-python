   "text": "same system, two kinds of test: white-box pytest pyramid vs. black-box equivalence suite",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "same system, two kinds of test: white-box pytest pyramid vs. black-box equivalence suite",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t1981389449",
   "type": "text",
   "x": 780.0,
   "y": 46,
   "width": 600.6,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
