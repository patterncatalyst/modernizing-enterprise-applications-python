   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "strangler-proxy and graphql-gateway are the only externally reachable workloads -- every other Service stays ClusterIP-only.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "strangler-proxy and graphql-gateway are the only externally reachable workloads -- every other Service stays ClusterIP-only.",
