   "seed": 528584959,
   "versionNonce": 313740718,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each hop (outbox -> relay -> topic -> consumer) is independently at-least-once; the monolith is BOTH the first producer",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each hop (outbox -> relay -> topic -> consumer) is independently at-least-once; the monolith is BOTH the first producer",
   "lineHeight": 1.25,
   "baseline": 11
  },
