   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "and the final consumer: a request that started as a checkout ends as a Kafka message the same process reacts to.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "and the final consumer: a request that started as a checkout ends as a Kafka message the same process reacts to.",
