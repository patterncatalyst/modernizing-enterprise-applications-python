  },
  {
   "id": "t1357166160",
   "type": "text",
   "x": 40,
   "y": 564,
   "width": 719.95,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1681839355,
   "versionNonce": 968081560,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each hop (outbox -> relay -> topic -> consumer) is independently at-least-once; the monolith is BOTH the first producer",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each hop (outbox -> relay -> topic -> consumer) is independently at-least-once; the monolith is BOTH the first producer",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
