   "baseline": 17
  },
  {
   "id": "t1540946833",
   "type": "text",
   "x": 40,
   "y": 564,
   "width": 719.95,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
