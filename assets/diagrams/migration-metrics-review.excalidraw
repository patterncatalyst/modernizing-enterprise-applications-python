   "text": "The real Phase A -> Phase B win is STRUCTURAL, not a startup-time number",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The real Phase A -> Phase B win is STRUCTURAL, not a startup-time number",
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "id": "t161046130",
   "type": "text",
   "x": 30,
   "y": 540,
   "width": 665.5,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1985766636,
   "versionNonce": 1637232041,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Phase A would carry: a synchronous Django ORM bridged into an async framework via sync_to_async on every query",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Phase A would carry: a synchronous Django ORM bridged into an async framework via sync_to_async on every query",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t460014268",
   "type": "text",
   "x": 30,
   "y": 555,
   "width": 580.8000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 563539908,
   "versionNonce": 425177705,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Phase A would carry: a hard build-time dependency on the entire monolith just to reach one model",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Phase A would carry: a hard build-time dependency on the entire monolith just to reach one model",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1768196560",
