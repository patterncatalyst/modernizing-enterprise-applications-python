   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green boxes (strangler-proxy, order-service, inventory-service) are the 3 OTel-instrumented services -- app depth. All 8 get mesh breadth automatically via Envoy.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Green boxes (strangler-proxy, order-service, inventory-service) are the 3 OTel-instrumented services -- app depth. All 8 get mesh breadth automatically via Envoy.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1463835350",
   "type": "text",
   "x": 240,
   "y": 772,
   "width": 1058.75,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
