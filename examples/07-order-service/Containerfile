# order-service -- UBI 10, multi-stage, non-root.
#
# Same verified base image as every other standalone service in this project
# (UBI 10 publishes only the `-minimal` Python 3.14 image; every dependency
# here ships a prebuilt wheel -- grpcio, protobuf, and aiokafka included, all
# of which publish cp314 manylinux wheels -- so `uv sync` never needs a C
# compiler). Re-verify the tag with
# `skopeo list-tags docker://registry.access.redhat.com/ubi10/python-314-minimal`
# before bumping.
ARG UBI_PYTHON_IMAGE=registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.1

FROM ${UV_IMAGE} AS uv

FROM ${UBI_PYTHON_IMAGE} AS builder
COPY --from=uv /uv /uvx /usr/local/bin/

WORKDIR /app

# Resolve dependencies first so dependency installs cache independently of
# application code changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev

COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./
RUN uv sync --locked --no-dev

FROM ${UBI_PYTHON_IMAGE}

WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1

# Non-root, OpenShift/arbitrary-UID compatible -- same convention as every
# other Containerfile in this project (no shadow-utils on the minimal image,
# so fix ownership instead of creating a user with useradd).
USER root
RUN chgrp -R 0 /app && chmod -R g=u /app
USER 1001:0

# HTTP read+command surface only (:8088) -- this service is a gRPC CLIENT of
# inventory-service, never a listener, so there is no second port to expose.
EXPOSE 8088

# `alembic upgrade head` runs this service's own migrations (creates the
# `order_svc` schema + all 5 tables + seeds customers Ada/Grace, a no-op if
# already applied) before the server starts.
#
# r10/ch.30 -- the server process (not the migration step) is wrapped with
# `opentelemetry-instrument` (opentelemetry-distro, zero-code: fastapi server
# spans, asyncpg/sqlalchemy DB spans, grpc CLIENT spans to inventory-service,
# aiokafka spans). NO-OP by default: `OTEL_SDK_DISABLED=true` in
# .env.example means this wrapper does not attempt OTLP export in
# compose/CI; only `deploy/k8s/base/app-config.yaml` flips it active,
# in-cluster only.
CMD ["sh", "-c", "alembic upgrade head && exec opentelemetry-instrument uvicorn app.main:app --host 0.0.0.0 --port 8088"]
