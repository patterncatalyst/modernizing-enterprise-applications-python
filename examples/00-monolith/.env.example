# Copy to .env (or export directly) for local development.
# These defaults match the INFRA lane's compose stack (infra/compose.yaml).

DATABASE_URL=postgresql://monolith:monolith@localhost:5432/monolith
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=insecure-demo-key-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=*
LOG_DIR=logs
