# .env.example — tracked template for compose.yaml's image-tag pins.
#
# `.env` itself is gitignored (no secrets committed — see root .gitignore).
# Copy this file to `.env` before running the stack:
#
#   cp .env.example .env
#   docker compose --env-file .env up -d
#
# 2026-10-15: every tag below was verified upstream that day with
# `skopeo list-tags` (stable releases only — betas/RCs excluded):
#   - docker.io/library/postgres   -> newest 18.x-alpine: 18.6-alpine
#   - docker.io/apache/kafka       -> newest 4.x.y:       4.3.1
#   - docker.io/grafana/otel-lgtm  -> newest 0.x.y:        0.36.0
# 2026-10-16: re-verified with the same method (quay.io, .Final releases only):
#   - quay.io/debezium/connect     -> newest 3.x.y.Final: 3.7.0.Final
# 2026-10-17: re-verified with `skopeo list-tags docker://quay.io/apicurio/apicurio-registry`
# (stable numeric releases only -- excluding -mutable/-snapshot/latest* tags):
#   - quay.io/apicurio/apicurio-registry -> newest 3.x.y: 3.3.3
# Re-run the same `skopeo list-tags docker://<repo>` check before bumping any
# pin; never float on `latest`.

# ─── Postgres — the monolith's database ────────────────────────────────────
# DATABASE_URL for the monolith (examples/00-monolith, once it lands):
#   postgresql://monolith:monolith@localhost:5432/monolith
# POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD below are consumed directly by
# the official postgres image's entrypoint, which creates this db + user
# automatically on first start (empty volume) — see infra/db/init/00-init.sql
# for the extensions provisioned on top of that.
POSTGRES_IMAGE_TAG=18.6-alpine
POSTGRES_DB=monolith
POSTGRES_USER=monolith
POSTGRES_PASSWORD=monolith
POSTGRES_PORT=5432

# ─── Kafka (KRaft mode, single broker) — present for later iterations ──────
# apache/kafka (the JVM image), not apache/kafka-native: the JVM image ships
# the /opt/kafka/bin/*.sh CLI tools this stack's healthcheck (and any future
# debug/verify scripts) rely on.
KAFKA_IMAGE_TAG=4.3.1
KAFKA_HOST_PORT=9092
# Any base64-ish string works; only change this if you destroy kafka-data
# and need a fresh cluster identity (stale cluster ID on an old volume is a
# common KRaft gotcha — wipe with `scripts/stack-down.sh -v` instead).
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ─── Grafana LGTM observability stack — present for later iterations ───────
# (Loki + Grafana + Tempo + Mimir) + embedded OpenTelemetry Collector
# (config replaced by infra/otelcol/config.yaml)
LGTM_IMAGE_TAG=0.36.0
# Host port for Prometheus (query + OTLP metrics ingest). Not 9090: Cockpit
# owns 9090 on Fedora Server and RHEL. Container port stays 9090.
PROMETHEUS_HOST_PORT=19090

# ─── Kafka Connect (Debezium Postgres connector) — CDC, r04, transition-only
# Image moved to quay.io — Debezium does not publish to Docker Hub.
CONNECT_IMAGE_TAG=3.7.0.Final
# Host port for the Connect REST API. Not 8083:
# examples/03-notification-service's FastAPI HTTP listener binds
# localhost:8083 when it's running, and the two would otherwise clash.
# Container port stays 8083.
CONNECT_HOST_PORT=8086

# ─── Apicurio Schema Registry (ch.28, DRQ-038 follow-up/DRQ-076) ───────────
# Used ONLY by examples/09-schema-registry-demo (see compose.yaml's header
# note and the apicurio service's own comment) -- no other service in this
# stack depends on it. 3.3.3 is the newest stable server image; its health
# endpoint moved to the management port 9000 (see compose.yaml's
# healthcheck).
APICURIO_IMAGE_TAG=3.3.3
APICURIO_HOST_PORT=8095

# ─── OpenTelemetry (r10/ch.30, DRQ-096=A) — additive, NO-OP by default ─────
# Only strangler-proxy (01), inventory-service (04), and order-service (07)
# are wrapped with `opentelemetry-instrument` (see each service's
# Containerfile). This default (`OTEL_SDK_DISABLED=true`) makes that wrapper
# a true no-op on compose/CI -- no OTLP export is attempted and no collector
# needs to be reachable, so the stack stays byte-for-byte unaffected here.
# `deploy/k8s/base/app-config.yaml`'s `mea-app-config` ConfigMap sets the
# ACTIVE equivalents (OTEL_SDK_DISABLED=false +
# http://lgtm.mea.svc.cluster.local:4317) for the live minikube/Istio
# environment only -- these three lines below are documentation/local-dev
# placeholders, never consumed by compose.yaml itself (compose only runs
# infra; 01/04/07 run locally via `uv run opentelemetry-instrument
# uvicorn ...`, reading these from the process environment if you source
# this file).
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=unset
